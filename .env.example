# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Mixpanel — MUST be the SAME project token the app (app.dynameet.ai) uses.
# One project is what makes the signup funnel continuous. A token for a
# DIFFERENT project fails silently: Mixpanel returns success for any valid
# token, so events are accepted and simply never appear in the project you are
# watching. Unset = no init, no events (local dev and CI stay silent).
NEXT_PUBLIC_MIXPANEL_TOKEN=

# CTAリンク（任意）
NEXT_PUBLIC_DEMO_URL=https://calendly.com/your-link
NEXT_PUBLIC_CONTACT_URL=https://forms.google.com/your-form

# Notion Blog
NOTION_TOKEN=secret_xxx...
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
