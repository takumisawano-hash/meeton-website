# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Mixpanel — MUST be the SAME project token the app (app.dynameet.ai) uses.
# One project is what makes the signup funnel continuous. A token for a
# DIFFERENT project fails silently: Mixpanel returns success for any valid
# token, so events are accepted and simply never appear in the project you are
# watching. Unset = no init, no events (local dev and CI stay silent).
NEXT_PUBLIC_MIXPANEL_TOKEN=

# LOCAL TESTING ONLY — retarget signup CTAs at a dev build of the app.
# Leave UNSET in production (CTAs then use their real app.dynameet.ai href).
# Needed because the funnel handshake can only be tested with both halves on
# the same Mixpanel project: production app.dynameet.ai reports to the
# production project, so a dev-token marketing build clicking through to it
# lands the two events in different projects — which looks exactly like a
# broken handshake even when the code is correct.
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001

# CTAリンク（任意）
NEXT_PUBLIC_DEMO_URL=https://calendly.com/your-link
NEXT_PUBLIC_CONTACT_URL=https://forms.google.com/your-form

# Notion Blog
NOTION_TOKEN=secret_xxx...
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# DocoDoco IP→company lookup (server-only — proxied via /api/docodoco-lookup,
# never expose these as NEXT_PUBLIC_*). DocoDoco's console has no way to
# domain-restrict keys, so they must stay server-side.
DOCODOCO_KEY1=
DOCODOCO_KEY2=
